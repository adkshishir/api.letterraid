generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── AUTH ────────────────────────────────────────────────

model Player {
  id          String   @id @default(cuid())
  email       String?  @unique
  displayName String
  avatarUrl   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // A seeded bot persona rather than a real signed-up player — see scripts/seed-bots.mjs.
  isBot Boolean @default(false)

  // Progression
  level   Int @default(1)
  xp      Int @default(0)
  trophies Int @default(0)

  // Stats (denormalized for fast reads)
  totalGames Int @default(0)
  totalWins  Int @default(0)
  winStreak  Int @default(0)
  bestStreak Int @default(0)

  // Relations
  sessions    Session[]
  otpCodes    OtpCode[]
  playedAsP1  Match[]    @relation("PlayerMatches")
  playedAsP2  Match[]    @relation("PlayerMatches2")
  wonMatches  Match[]    @relation("PlayerWins")
  claims      Claim[]

  clanMembership      ClanMember?
  tournamentsCreated  Tournament[]             @relation("TournamentCreator")
  tournamentEntries   TournamentParticipant[]

  @@index([trophies])
  @@index([email])
}

model Session {
  id        String   @id @default(cuid())
  playerId  String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([playerId])
}

model OtpCode {
  id        String   @id @default(cuid())
  playerId  String?
  email     String
  code      String
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  player Player? @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@index([email, code])
}

// ─── GAME DATA ──────────────────────────────────────────

model Match {
  id       String      @id @default(cuid())
  game     String
  status   MatchStatus @default(PLAYING)
  roomCode String      @unique

  startedAt DateTime @default(now())
  endedAt   DateTime?

  player1Id String
  player2Id String?
  winnerId  String?
  tied      Boolean   @default(false)

  // Final score, denormalized so history/profile reads don't need to replay claims.
  player1Score Int @default(0)
  player2Score Int @default(0)
  player1Words Int @default(0)
  player2Words Int @default(0)

  player1 Player @relation("PlayerMatches", fields: [player1Id], references: [id])
  player2 Player? @relation("PlayerMatches2", fields: [player2Id], references: [id])
  winner  Player? @relation("PlayerWins", fields: [winnerId], references: [id])

  claims Claim[]

  @@index([player1Id])
  @@index([player2Id])
  @@index([status])
  @@index([endedAt])
}

model Claim {
  id                 String @id @default(cuid())
  matchId            String
  playerId           String
  word               String
  points             Int
  type               ClaimType
  stolenFromPlayerId String?

  match  Match  @relation(fields: [matchId], references: [id], onDelete: Cascade)
  player Player @relation(fields: [playerId], references: [id])

  @@index([matchId])
  @@index([playerId])
}

enum MatchStatus {
  PLAYING
  COMPLETE
}

enum ClaimType {
  POOL
  STEAL
}

// ─── CLANS ──────────────────────────────────────────────
//
// A player belongs to at most one clan at a time — `ClanMember.playerId` is
// unique, so "my clan" is always a single lookup, never a list.

model Clan {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())

  members     ClanMember[]
  tournaments Tournament[]
}

model ClanMember {
  id       String   @id @default(cuid())
  clanId   String
  playerId String   @unique
  role     ClanRole @default(MEMBER)
  joinedAt DateTime @default(now())

  clan   Clan   @relation(fields: [clanId], references: [id], onDelete: Cascade)
  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@index([clanId])
}

enum ClanRole {
  LEADER
  MEMBER
}

// ─── TOURNAMENTS ────────────────────────────────────────
//
// "Clash Royale style": a fixed member cap and a countdown, not a bracket.
// Anyone in it can queue for a 1v1 Heist match against another participant at
// any point before the clock runs out; standings are ranked by league-style
// points (win/tie/loss), not elimination. See `TournamentsService`.

model Tournament {
  id          String   @id @default(cuid())
  /// Short shareable join code, same charset as room codes but its own space.
  code        String   @unique
  name        String
  maxMembers  Int
  durationMin Int
  createdAt   DateTime @default(now())
  /// Set by the host's `POST /tournaments/:id/start`; null means the
  /// tournament is still a lobby (players can join, but not queue for
  /// matches). Duration counts down from here, not from `createdAt`.
  startedAt   DateTime?
  /// Null while in the lobby (not yet started); set to `startedAt + durationMin` on start.
  endsAt      DateTime?
  creatorId   String
  /// Null for a public tournament; set for one hosted by a clan for its own members.
  clanId      String?

  creator      Player                  @relation("TournamentCreator", fields: [creatorId], references: [id])
  clan         Clan?                   @relation(fields: [clanId], references: [id], onDelete: SetNull)
  participants TournamentParticipant[]

  @@index([clanId])
  @@index([endsAt])
}

model TournamentParticipant {
  id           String   @id @default(cuid())
  tournamentId String
  playerId     String
  wins         Int      @default(0)
  losses       Int      @default(0)
  /// League-style score: +3 win, +1 tie, +0 loss. The standings sort key.
  points       Int      @default(0)
  joinedAt     DateTime @default(now())

  tournament Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  player     Player     @relation(fields: [playerId], references: [id])

  @@unique([tournamentId, playerId])
  @@index([tournamentId])
}

/// Self-tuning knob per bot tier (see BotTier in heist-bot.service.ts). Starts
/// at multiplier 1.0 (today's hand-tuned TIER_CONFIG baseline) and nudges
/// after every ranked bot-fallback match toward each tier's target human word
/// share, so a tier that's still crushing humans gets slower/miss-happier on
/// its own without another manual retune. Practice matches (explicit tier
/// choice) don't feed this — see BotDifficultyService.
model BotDifficultyState {
  tier            String   @id
  thinkMultiplier Float    @default(1)
  whiffMultiplier Float    @default(1)
  matchesSeen     Int      @default(0)
  lastHumanShare  Float?
  updatedAt       DateTime @updatedAt
}
