# Port the Nest server listens on. 4042 in production (imposter holds 4021/4022,
# Cahoots holds 4031/4032).
PORT=4042

# Comma-separated allowed CORS origins for the frontend.
# Production example: https://letterraid.com,https://www.letterraid.com
CORS_ORIGINS=http://localhost:4041,http://localhost:3000
