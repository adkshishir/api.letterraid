# Port the Nest server listens on. 4042 in production (imposter holds 4021/4022,
# Cahoots holds 4031/4032).
PORT=4042

# Comma-separated allowed CORS origins for the frontend.
# Production example: https://letterraid.com,https://www.letterraid.com
CORS_ORIGINS=http://localhost:4041,http://localhost:3000

# Postgres connection string. See prisma/schema.prisma.
DATABASE_URL="postgresql://user:password@localhost:5432/letterraid"

# Signs auth JWTs. Must be set to a real secret in production — the code falls
# back to a hardcoded dev value if this is unset, which is not safe to ship.
JWT_SECRET="change-me"

# Gmail SMTP for OTP login codes. MAIL_PASSWORD is a Gmail App Password, not
# the account password (https://myaccount.google.com/apppasswords). Without
# these, OTP codes are only logged server-side rather than emailed — fine for
# local dev, not for anyone outside this box.
MAIL_USERNAME=
MAIL_PASSWORD=
